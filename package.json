    "test:release": "node --test tests/release-audit/*.test.mjs",
    "ui:check": "node scripts/ui-polish/check.mjs",
    "test:ui": "node --test tests/ui-polish/*.test.mjs",
    "experience:build": "node scripts/experience/build.mjs",
    "experience:check": "node scripts/experience/check.mjs",
    "test:experience": "node --test tests/experience/*.test.mjs",
    "launch:build": "node scripts/launch/build.mjs",
