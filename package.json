    "release:prepare": "node scripts/publication/build.mjs --prepare --report",
    "release:check": "node scripts/publication/build.mjs --check --report",
    "release:test": "node --test tests/publication/*.test.mjs",
    "release:review": "node scripts/publication/gate.mjs --init",
    "release:gate": "node scripts/publication/gate.mjs",
    "release:serve": "node scripts/publication/serve.mjs",
    "showcase:build": "node scripts/showcase/build.mjs",
