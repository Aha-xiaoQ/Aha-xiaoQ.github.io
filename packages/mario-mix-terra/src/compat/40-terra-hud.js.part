 if(s.cloudJump)gear.push({key:'cloudBottle',name:'云朵瓶'});
 if(s.t13Accessories?.boots)gear.push({key:'hudBoots',name:'赫尔墨斯靴'});
 if(s.t13Accessories?.regen)gear.push({key:'hudRegen',name:'再生手环'});
