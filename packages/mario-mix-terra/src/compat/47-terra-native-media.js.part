const T23_UNDERGROUND_NATIVE={"NPC483":"__TERRA_ASSET_media-189__","NPC6":"__TERRA_ASSET_media-190__","NPC634":"__TERRA_ASSET_media-191__","NPC635":"__TERRA_ASSET_media-192__","Tiles367":"__TERRA_ASSET_media-193__","Tiles368":"__TERRA_ASSET_media-194__","Tiles71":"__TERRA_ASSET_media-195__"};
const t23UndergroundReady=Promise.all(Object.entries(T23_UNDERGROUND_NATIVE).map(([key,src])=>t21ImageLoad(key,src,3000)));
Object.assign(T21_NPCS,{
 sporeBat:{name:'孢子蝙蝠',art:'NPC634',fw:44,fh:40,n:3,w:26,h:20,hp:136,damage:16,defense:2,style:'bat'},
 sporeSkeleton:{name:'孢子骷髅',art:'NPC635',fw:40,fh:56,n:16,w:22,h:42,hp:152,damage:22,defense:8,style:'walker'},
 graniteElemental:{name:'花岗岩精',art:'NPC483',fw:60,fh:60,n:22,w:32,h:32,hp:144,damage:24,defense:14,style:'chase'},
 eaterOfSouls:{name:'噬魂怪',art:'NPC6',fw:42,fh:80,n:2,w:30,h:40,hp:144,damage:20,defense:6,style:'chase'}
});
const T23_UNDERGROUND_KEYS=new Set(['sporeBat','sporeSkeleton','graniteElemental','eaterOfSouls']);
const t23UndergroundMoveBase=t21NpcMove;
t21NpcMove=function(s,e,surfaces){
 if(e.t21Species==='graniteElemental'&&!e.dead){
  // Expert-style hurt reaction: contract and fall, then resume pursuit.
  if(e.t23GuardTicks>0){
   e.t23GuardTicks--;e.active=true;e.age++;e.vx=0;e.t23Guard=true;if(e.flash)e.flash--;
   const feet=e.y+e.h;e.vy=Math.min(6,e.vy+.28);e.y+=e.vy;
   for(const q of surfaces)if(e.x+e.w>q.x&&e.x<q.x+q.w&&feet<=q.y+.6&&e.y+e.h>=q.y){e.y=q.y-e.h;e.vy=0;}
   if(near(s.p,e))t21NpcDamage(s,T21_NPCS.graniteElemental.damage,e.x+e.w/2);return;
  }
  e.t23Guard=false;
 }
 return t23UndergroundMoveBase(s,e,surfaces);
};
const t23UndergroundDamageBase=r06DamageTarget;
r06DamageTarget=function(t,damage,kind){
 if(t?.obj?.t23Guard&&!t.obj.dead){t.obj.flash=4;return;}
 const hp=t?.obj?.hp,out=t23UndergroundDamageBase(t,damage,kind),e=t?.obj;
 if(e?.t21Species==='graniteElemental'&&!e.dead&&e.hp<hp){e.t23HurtCount=(e.t23HurtCount||0)+1;if(e.t23HurtCount%2===0){e.t23GuardTicks=42;e.t23Guard=true;e.vy=0;}}
