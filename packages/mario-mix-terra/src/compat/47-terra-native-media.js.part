// R26 audio fallback: remote Terraria clips are optional; embedded effects stay audible offline.
const t26TerraSoundBase=terraSound;
const t26SfxFallback={gun:'hit',bow:'hit',npcDeath:'hit',pickup:'hit',coin:'hit',menu:'hit',chat:'hit',door:'build',heal:'hit',treeFell:'break',jump:'hit',appear:'build',powerup:'build',mount:'build',clear:'build',flag:'build',firework:'hit',hurry:'hit'};
terraSound=function(key,options={}){
 const result=t26TerraSoundBase(key,options);if(result||!isTrio()||!soundOn||!audio)return result;
 const fallback=t26SfxFallback[key];if(!fallback)return result;
 const play=()=>bank.has('trio13_'+fallback)?oneShot('trio13_'+fallback,options):0;
 const immediate=play();if(immediate)return immediate;
 if(typeof loadExtraAudio==='function')loadExtraAudio().then(()=>{if(mode==='playing'&&soundOn&&audio)play();}).catch(()=>{});
 return 0;
};

// R26 cactus contact: every desert cactus uses the same damage gate; existing invulnerability prevents duplicate hits.
const t26MainStepBase=r04MainStep;
function t26CactusHazard(s){
 if(!s||s.r05Arena||mode!=='playing'||s.p.invuln||s.p.hurtLock||s.t26CactusLock>0)return;
 const p=s.p;
 for(const t of s.trees||[]){
  const biome=t.t16Biome||t16BiomeAt?.(t.x,s)?.id;if(biome!=='desert'||t.hp<=0)continue;
  const h=Math.max(24,t.visualH||t.h||60),box={x:t.x-14,y:t.y-h+6,w:28,h:h-6};
  if(p.x+p.w>box.x&&p.x<box.x+box.w&&p.y+p.h>box.y&&p.y<box.y+box.h){s.t26CactusLock=24;r05Hurt(8,t.x);evt('cactus-hurt',{id:t.id});break;}
 }
}
r04MainStep=function(v){const s=state,ret=t26MainStepBase(v);if(state===s&&s&&!s.r05Arena){if(s.t26CactusLock>0)s.t26CactusLock--;t26CactusHazard(s);}return ret;};
