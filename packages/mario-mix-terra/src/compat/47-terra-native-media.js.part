const t23UndergroundNpcDrawBase=t21DrawNpc;
t21DrawNpc=function(e,c){
 if(!T23_UNDERGROUND_KEYS.has(e.t21Species))return t23UndergroundNpcDrawBase(e,c);
 if(e.dead)return true;
 const d=T21_NPCS[e.t21Species],im=t21Art[d.art];if(!im)return true;
 let frame=Math.floor(e.age/(d.style==='walker'?7:6))%d.n;
 if(e.t21Species==='sporeSkeleton')frame=Math.abs(e.vx)>.1?2+Math.floor(e.age/7)%12:0;
 if(e.t21Species==='graniteElemental')frame=e.t23Guard?16+Math.floor(e.age/8)%6:Math.floor(e.age/6)%14;
 const sc=e.t21Scale||1;
 const flying=d.style!=='walker';
 ctx.save();ctx.imageSmoothingEnabled=false;ctx.translate(Math.round(e.x+e.w/2-c),Math.round(e.y+(flying?e.h/2:e.h)));ctx.scale(e.dir<0?sc:-sc,sc);
 if(e.flash%2)ctx.globalAlpha=.65;
 ctx.drawImage(im,0,frame*d.fh,d.fw,d.fh,-d.fw/2,flying?-d.fh/2:-d.fh+2,d.fw,d.fh);ctx.restore();return true;
};
const t23UndergroundTextureBase=t17DeepTexture;
t17DeepTexture=function(kind,bid,v){
 if((bid!==6&&bid!==7)||kind>=3)return t23UndergroundTextureBase(kind,bid,v);
 const im=t21Art[bid===6?'Tiles368':'Tiles367'];if(!im)return t23UndergroundTextureBase(kind,bid,v);
 const key='r23-native:'+bid+':'+v;if(t17DeepTextureCache.has(key))return t17DeepTextureCache.get(key);
 const cv=document.createElement('canvas');cv.width=cv.height=16;const g=cv.getContext('2d');g.imageSmoothingEnabled=false;
 // Terraria full-block interior variants use 16px cells on an 18px atlas grid.
 g.drawImage(im,(1+v%3)*18,18,16,16,0,0,16,16);t17DeepTextureCache.set(key,cv);return cv;
};
const t23UndergroundDrawBase=t17DrawDeep;
t17DrawDeep=function(s){
 const w=s.t13World,all=w.decor;
 // Replace the procedural blue rectangle mushrooms with their native atlas.
 const native=t21Art.Tiles71;w.decor=native?all.filter(d=>d.biome!==5):all;
 try{t23UndergroundDrawBase(s);}finally{w.decor=all;}
 if(!native)return;ctx.save();ctx.imageSmoothingEnabled=false;
 for(const d of all)if(d.biome===5&&d.x>s.cam-24&&d.x<s.cam+R06_VIEW.w+24&&d.y>(s.camY||0)-24&&d.y<(s.camY||0)+R06_VIEW.h+24){
  const v=Math.floor(t13Hash(Math.floor(d.x/16),Math.floor(d.y/16),23)*5)%5;
  ctx.drawImage(native,v*18,0,16,20,Math.round(d.x-s.cam-8),Math.round(d.y-20),16,20);
 }
 ctx.restore();
};
function t23UndergroundPopulate(s){
 const w=s?.t13World;if(!w||w.t23Ecology||!t21Art.NPC634||!t21Art.NPC483)return;
 // Keep the fixed seeded spawn layout; only fill an ecology missing its own encounter.
 w.t23Ecology=true;
 for(const bid of [5,6,8]){
  const existing=w.deepFoes.filter(e=>e.biome===bid);if(existing.length>=2)continue;
  let added=0;
  for(let cy=24;cy<102&&existing.length+added<2;cy+=2)for(let cx=8;cx<w.cols-8&&existing.length+added<2;cx+=2){
   if(w.regions[cy*w.cols+cx]!==bid||t13At(w,cx,cy)||t13At(w,cx,cy-1)||t13At(w,cx,cy-2)||!t13At(w,cx,cy+1))continue;
   const x=cx*16,y=T13.top+(cy+1)*16-40;
   if(w.chests.some(q=>Math.hypot(q.x-x,q.y-y)<120)||w.deepFoes.some(e=>Math.hypot(e.x-x,e.y-y)<190))continue;
   w.deepFoes.push({id:'r17-deep-r23-'+bid+'-'+added,kind:'zombie',x,y,w:22,h:40,hp:100,maxHp:100,elite:false,flying:false,age:0,active:false,vx:0,vy:0,dir:-1,grounded:true,dead:false,flash:0,knock:0,jumpWait:20,biome:bid,skin:'blue'});added++;
  }
 }
 t21Populate(s);
 // The old generator checked one tile wide, while actors can span two or three.
 // Move a blocked spawn a few pixels inside the same chamber; never carve terrain.
 const clear=(e,x,y)=>{for(let cy=Math.floor((y-T13.top)/16);cy<=Math.floor((y+e.h-.1-T13.top)/16);cy++)for(let cx=Math.floor(x/16);cx<=Math.floor((x+e.w-.1)/16);cx++)if(t13At(w,cx,cy))return false;return true;};
 for(const e of w.deepFoes){
  if(T23_UNDERGROUND_KEYS.has(e.t21Species))e.t23Underground=true;
  if(clear(e,e.x,e.y))continue;
  let done=false;
  for(const dy of [0,-8,-16,-24,-32]){for(const dx of [0,-8,8,-16,16,-24,24,-32,32])if(clear(e,e.x+dx,e.y+dy)){e.x+=dx;e.y+=dy;done=true;break;}if(done)break;}
 }
}
const t23UndergroundStepBase=step;
step=function(v){const out=t23UndergroundStepBase(v);if(state?.r05Arena)t23UndergroundPopulate(state);return out;};
if(new URLSearchParams(location.search).get('test')==='1')Object.assign(t21Diagnostics,{
 undergroundReady:t23UndergroundReady,
 underground:()=>({biomes:T17_BIOMES.map((b,i)=>({id:i,name:b.name,cells:[...(state?.t13World?.regions||[])].filter(v=>v===i).length})),enemies:state?.t13World?.deepFoes,assets:Object.keys(T23_UNDERGROUND_NATIVE)}),
