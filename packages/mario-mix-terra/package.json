{
  "name": "mario-mix-terra",
  "version": "0.4.3",
  "private": true,
  "type": "module",
  "description": "第三期开发版：玩家界面、清晰提示与模块化源码",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "verify:baseline": "node scripts/build.mjs --baseline",
    "test": "node --test tests/*.test.mjs",
    "dev": "node scripts/serve.mjs",
    "reference": "node scripts/serve.mjs --reference",
    "pack": "node scripts/pack.mjs",
    "test:browser": "python scripts/browser-compare.py",
    "arch:check": "node scripts/architecture.mjs --check-docs",
    "docs:build": "node scripts/architecture.mjs --docs",
    "tasks": "node scripts/collaboration.mjs",
    "handoff": "node scripts/collaboration.mjs --handoff",
    "test:settings": "node --test tests/settings.test.mjs",
    "verify": "npm run check && npm test && npm run verify:baseline && node scripts/build.mjs --check",
    "release:check": "node scripts/release-check.mjs",
    "test:settings-browser": "python scripts/browser-settings.py",
    "stage:check": "node scripts/stages.mjs",
    "stage:new": "node scripts/stages.mjs --new",
    "test:stages": "node --test tests/stages.test.mjs",
    "test:stages-browser": "python scripts/browser-stages.py",
    "test:new-content": "python scripts/browser-new-content.py",
    "test:loot": "node --test tests/loot.test.mjs",
    "prepublish:check": "node scripts/prepublish.mjs",
    "test:publication-browser": "python scripts/browser-publication.py",
    "test:ui": "node --test tests/presentation.test.mjs",
    "test:ui-browser": "python scripts/browser-player-ui.py && python scripts/browser-player-normal.py",
    "test:polish": "node --test tests/release-polish.test.mjs",
    "test:polish-browser": "python scripts/browser-release-polish.py",
    "test:player-ui": "node --test tests/player-ui.test.mjs",
    "test:player-browser": "python scripts/browser-player-ui.py",
    "test:player-normal": "python scripts/browser-player-normal.py"
  },
  "license": "SEE LICENSE IN upstream/NOTICE.txt"
}
